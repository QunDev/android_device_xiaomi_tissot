# === Complete device profile: Pixel 6 (oriole) / Android 13 ===
# Applied every boot by 05-tissot-newid.sh via `resetprop -n`. Consistent with
# PIF MODEL=Pixel 6. Also overrides ro.product.*.name=lineage_tissot (hides the
# LineageOS tell). ro.hardware/ro.board.platform are deliberately NOT changed
# (real SoC = msm8953; changing them risks breaking HALs). ro.build.version.*
# (release=13/sdk=33) kept = the real ROM so apps don't see a version mismatch.
# security_patch is left as-is (recent, needed for Play Integrity STRONG); note
# it won't match the 2023 base build id — a deep cross-check could spot that.
# To use a different model, edit all values consistently (keep the fingerprint =
# brand/product/device:release/id/incremental:type/tags).

ro.product.brand=google
ro.product.manufacturer=Google
ro.product.model=Pixel 6
ro.product.device=oriole
ro.product.name=oriole
ro.product.system.brand=google
ro.product.system.manufacturer=Google
ro.product.system.model=Pixel 6
ro.product.system.device=oriole
ro.product.system.name=oriole
ro.product.vendor.brand=google
ro.product.vendor.manufacturer=Google
ro.product.vendor.model=Pixel 6
ro.product.vendor.device=oriole
ro.product.vendor.name=oriole
